# docker specific settings
COMPOSE_PROJECT_NAME=jstats8
CERTS_DIR=/usr/share/elasticsearch/config/certificates
VERSION=8.19.1
ES_CONTAINER_NAME=es01-8
KIBANA_CONTAINER_NAME=kib01-8
CERTS_CONTAINER_NAME=create_certs_8
JSTATS_CONTAINER_NAME=jstats-8
ELASTIC_HOST_PORT=9208
KIBANA_HOST_PORT=5608

# app configuration settings
NODE_ENV=development
HOSTNAME=localhost
PORT=3000
ELASTIC_ENDPOINT=https://es01
ELASTIC_PORT=9200
HOST_ELASTIC_ENDPOINT=https://localhost
HOST_ELASTIC_PORT=9208
KIBANA_URL=https://localhost:5608
TIMEZONE=Asia/Bangkok
ORGANIZATION=GITHUBORGANIZATION
API_KEY=
GITHUB_TOKEN=

# Jira configuration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_JQL=
JIRA_PROJECT_KEYS=
# Statuses that count as being in QA, case insensitive. Includes the queue
# states as well as the active ones, so the cycle measures from the handover
# out of development to the moment the issue leaves QA. Passed QA and Pending
# Release are exits and must not appear here.
JIRA_QA_STATUSES=Ready to QA,Waiting QA,Ready for Testing,Ready to test,In QA,QA,Testing
JIRA_API_TOKEN_HOST_PATH=/dev/null

# Local-only passwords. Keep these two the same for the 8.x clean-rebuild stack.
ES_BOOTSTRAP_PASSWORD=change-me
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me
KIBANA_ELASTICSEARCH_USERNAME=kibana_system
